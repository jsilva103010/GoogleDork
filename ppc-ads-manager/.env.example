# Required for AI campaign generation and AI-assisted optimization narratives.
# Without it, the app still runs: rule-based optimization keeps working, but
# "Generate Campaign" and "AI Insights" will return a clear error until set.
ANTHROPIC_API_KEY=

# mock (default) = simulate Google Ads locally, no external account needed.
# live = use the real Google Ads API (requires the fields below + `pip install google-ads`).
GOOGLE_ADS_MODE=mock

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# If true, the optimizer applies its recommendations automatically instead of
# just logging them for human review. Off by default — this manages real ad
# spend for a law firm, so start supervised.
AUTO_APPLY_OPTIMIZATIONS=false

# Minutes between automated optimization cycles.
OPTIMIZATION_INTERVAL_MINUTES=60
